# API Configuration
PORT=8000
HOST=0.0.0.0

# Your Vercel frontend URL (used for CORS)
# Set this on the Render dashboard — e.g. https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# Groq API Key — used for LLM chat responses
# Get yours at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Path for FAISS index + uploaded PDFs
# On Render: set to /data (mount a persistent disk at /data)
# Locally: leave as ./data
BASE_PATH=./data
